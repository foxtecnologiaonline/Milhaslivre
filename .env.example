# Postgres (1 schema por módulo: identity, seller, catalog, inventory, cart,
# checkout, payments, orders, shipping, reviews)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

# Redis (BullMQ - filas/eventos de domínio)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
JWT_SECRET=change-me

# Storefront (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Integrações (entram a partir dos itens 4/8/9 do backlog — vazio por enquanto)
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
# Pagar.me: sem essas duas, payments faz no-op seguro (loga e segue, sem cobrar de verdade)
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=
# Melhor Envio: sem essa, shipping faz no-op seguro (cotação R$0, sem gerar etiqueta de verdade)
MELHOR_ENVIO_TOKEN=
SHIPPING_ORIGIN_ZIP_CODE=01310-100
