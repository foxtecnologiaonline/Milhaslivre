# Database
DATABASE_URL=postgresql://user:password@localhost:5432/milhaslivre

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Twilio/WhatsApp
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email (SendGrid) - optional, notifications are skipped (logged only) when unset
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@milhaslivre.com

# Payments (Stripe) - optional, checkout/webhook are skipped when unset
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Frontend
VITE_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Cloudflare Workers
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
